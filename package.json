{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint --max-warnings=0 .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm knip && pnpm check:i18n && pnpm check:rules",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.9.0",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "negotiator": "1.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/negotiator": "0.6.5",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "16.4.0",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
