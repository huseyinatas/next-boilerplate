{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm knip)",
      "Bash(pnpm check:i18n)",
      "Bash(pnpm check:rules)",
      "Bash(pnpm build)",
      "Bash(pnpm install)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec next typegen)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/REVIEW.md)",
      "Edit(/package.json)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/tsconfig.json)",
      "Edit(/next.config.ts)",
      "Edit(/eslint.config.mjs)",
      "Edit(/knip.jsonc)",
      "Edit(/lefthook.yml)",
      "Edit(/vitest.config.mts)",
      "Edit(/.prettierrc.json)",
      "Edit(/.prettierignore)",
      "Edit(/src/**/*.test.ts)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/scripts/**)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(/.env.development)",
      "Read(/.env.production)",
      "Read(/.env.test)",
      "Edit(/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent/stop-gate.mjs", "baseline"],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent/guard-bash.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent/after-edit.mjs"],
            "timeout": 60,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent/stop-gate.mjs"],
            "timeout": 300,
            "statusMessage": "Running pnpm check and pnpm build"
          }
        ]
      }
    ]
  }
}
